<div class="container">
    <section id="experiences">
        {{#if msg}}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{/if}}
        <a class="btn btn-success mb-3" href="/experiences-admin-add" role="button"><i class="bi bi-plus-lg"></i> Add Experiences</a>
        <table class="table table-striped table-dark table-bordered">
            <thead>
                <tr>
                    <th scope="col">No</th>
                    <th scope="col">Position</th>
                    <th scope="col">Company</th>
                    <th scope="col" width="200">Period</th>
                    <th scope="col" width="150">Company Logo</th>
                    <th scope="col" width="300">Action</th>
                </tr>
            </thead>
            <tbody>
                {{#if dataExperiences.length}}
                    {{#each dataExperiences }}
                        <tr>
                            <th scope="row">{{ increment @index }}</th>
                            <td>{{ this.position }}</td>
                            <td>{{ this.company }}</td>
                            <td>{{ formatDate this.start_date }} - {{ formatDate this.end_date }}</td>
                            <td class="text-center">
                                <img src="/assets/img/upload_company/{{ this.company_logo }}" width="100" alt="">
                            </td>
                            <td>
                                <a href="/experiences-admin/edit/{{ this.id }}" class="btn btn-warning"><i class="bi bi-pencil-square"></i> Edit</a>
                                <a href="/experiences-admin/detail/{{ this.id }}" class="btn btn-info"><i class="bi bi-info-circle-fill"></i> Detail</a>
                                <a href="/experiences-admin/delete/{{ this.id }}" class="btn btn-danger"><i class="bi bi-trash-fill"></i> Delete</a>
                            </td>
                        </tr>
                    {{/each}}       
                {{else}}
                    <tr>
                        <td colspan="7">
                            <div class="alert alert-warning text-center" role="alert">
                                No data yet
                            </div>                          
                        </td>
                    </tr>
                {{/if}}
            </tbody>
        </table>
    </section>
</div>