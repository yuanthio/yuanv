<div class="container">
    <div class="row d-flex justify-content-center align-items-center detail py-5">
        <div class="col-lg-6 my-5">
            <div class="card">
                {{#if data}}
                    <div class="logo text-center p-4">
                        <img src="/assets/img/upload_company/{{ data.company_logo }}" width="150" alt="{{ data.company }}">
                    </div>
                    <div class="card-body">
                        <table class="table table-striped table-bordered table-dark">
                            <tbody>
                                <tr>
                                    <th scope="row" width="150">Position</th>
                                    <td>{{ data.position }}</td>
                                </tr>
                                <tr>
                                    <th scope="row" width="150">Company</th>
                                    <td>{{ data.company }}</td>
                                </tr>
                                <tr>
                                    <th scope="row" width="150">Start Date</th>
                                    <td>{{ formatDate data.start_date }}</td>
                                </tr>
                                <tr>
                                    <th scope="row" width="150">End Date</th>
                                    <td>{{ formatDate data.end_date }}</td>
                                </tr>
                                <tr>
                                    <th scope="row" width="150">Descriptions</th>
                                    <td>
                                        {{#each data.description }}
                                            <ul>
                                                <li>{{ this }}</li>
                                            </ul>
                                        {{/each}}
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" width="150">Technologies</th>
                                    <td>
                                        {{#each data.technologies }}
                                            <ul>
                                                <li>{{ this }}</li>
                                            </ul>
                                        {{/each}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="btns d-flex justify-content-center">
                            <a href="/experiences-admin" class="btn btn-danger"><i class="bi bi-backspace-fill"></i> Back to data experiences</a>
                        </div>
                    </div>
                {{else}}
                    <div class="alert alert-warning text-center" role="alert">
                        No data yet
                    </div> 
                {{/if}}
            </div>
        </div>
    </div>
</div>